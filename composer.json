{
  "name": "its/solidarity",
  "description": "solidarity",
  "license": "",
  "type": "project",
  "repositories": [
    {
      "type": "git",
      "url" : "https://bitbucket.org/dj_avolak/skeletor"
    }
  ],
  "require": {
    "dj_avolak/skeletor": "6.x-dev",
    "symfony/string": "^7",
    "laminas/laminas-session": "^2.21.0",
    "nesbot/carbon": "*",
    "phpoffice/phpspreadsheet": "*",
    "mailersend/mailersend": "^0.30.0",
    "turanjanin/serbian-transliterator": "*",
    "beberlei/doctrineextensions": "^1.5",
    "doctrine/orm": "^3.3.2",
    "chillerlan/php-qrcode": "^5"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0",
    "phpmd/phpmd": "*",
    "roave/security-advisories": "dev-master",
    "rregeer/phpunit-coverage-check": "*"
  },
  "autoload": {
    "psr-4": {
      "Solidarity\\Core\\": "packages/Core/src",
      "Solidarity\\Backend\\": "packages/Backend/src",
      "Solidarity\\Frontend\\": "packages/Frontend/src",
      "Solidarity\\Mailer\\": "packages/Mailer/src",
      "Solidarity\\Transliterator\\": "packages/Transliterator/src",
      "Solidarity\\Donor\\": "packages/Donor/src",
      "Solidarity\\Transaction\\": "packages/Transaction/src",
      "Solidarity\\School\\": "packages/School/src",
      "Solidarity\\SchoolType\\": "packages/SchoolType/src",
      "Solidarity\\City\\": "packages/City/src",
      "Solidarity\\User\\": "packages/User/src",
      "Solidarity\\Delegate\\": "packages/Delegate/src",
      "Solidarity\\Beneficiary\\": "packages/Beneficiary/src",
      "Solidarity\\Period\\": "packages/Period/src",
      "Solidarity\\Page\\": "packages/Page/src",
      "Solidarity\\EmailList\\": "packages/EmailList/src",
      "Solidarity\\Post\\": "packages/Post/src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Solidarity\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": [
      "@putenv XDEBUG_MODE=coverage",
      "phpunit --coverage-html public/coverage"
    ],
    "test:gate": [
      "@putenv XDEBUG_MODE=coverage",
      "phpunit --coverage-clover data/coverage/clover.xml",
      "coverage-check data/coverage/clover.xml 50"
    ]
  },
  "config": {
    "preferred-install": "dist",
    "bin-dir": "vendor/bin/",
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
