#!/usr/bin/env php
<?php

use Doctrine\ORM\Tools\Console\ConsoleRunner;
use Doctrine\ORM\Tools\Console\EntityManagerProvider\SingleManagerProvider;

// Same reason as public/index.php: config/constants.php is gitignored and deployed as a
// SHARED symlink, so __DIR__ inside it resolves to the shared directory rather than the
// release. Every entry point therefore defines APP_PATH from its own __DIR__ — a real file
// inside the release — and constants.php yields to it.
define('APP_PATH', dirname(__DIR__));

include(APP_PATH . "/config/constants.php");
include(APP_PATH . "/vendor/autoload.php");
$container = require APP_PATH . '/config/bootstrap.php';

ConsoleRunner::run(
    new SingleManagerProvider($container->get(\Doctrine\ORM\EntityManagerInterface::class))
);